{
  "name": "rws-js",
  "version": "1.0.0",
  "description": "Regar WebSocket client SDK - Standard payload wrapper untuk koneksi WebSocket Regarmarket",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "websocket",
    "socket.io",
    "regarmarket",
    "realtime"
  ],
  "license": "MIT",
  "devDependencies": {
    "typescript": "^5.5.0",
    "vite": "^6.0.0",
    "vite-plugin-dts": "^4.0.0"
  },
  "dependencies": {
    "socket.io-client": "^4.8.1"
  }
}
