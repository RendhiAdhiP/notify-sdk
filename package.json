{
  "name": "rws-sdk",
  "version": "2.0.0",
  "private": true,
  "description": "RWS SDK — Realtime WebSocket client untuk notifikasi, chat, dan event realtime multi-tenant",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "socket.io-client": "^4.8.0"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "vite": "^6.0.0",
    "vite-plugin-dts": "^4.0.0"
  },
  "keywords": [
    "rws",
    "websocket",
    "socket.io",
    "realtime",
    "notification",
    "chat",
    "sdk"
  ],
  "license": "MIT"
}
